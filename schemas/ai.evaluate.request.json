{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BINAH AI Evaluation Request",
  "type": "object",
  "required": ["need", "gap", "alternatives"],
  "properties": {
    "need": {
      "type": "string",
      "minLength": 1
    },
    "gap": {
      "type": "string",
      "minLength": 1
    },
    "alternatives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "evidence.json"
      }
    }
  }
}