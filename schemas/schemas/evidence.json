{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BINAH Evidence",
  "type": "object",
  "required": ["source", "observation"],
  "properties": {
    "source": {
      "type": "string",
      "minLength": 1
    },
    "observation": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": ["string", "null"]
    },
    "reliability": {
      "type": ["string", "null"],
      "enum": ["high", "medium", "low", null]
    }
  }
}